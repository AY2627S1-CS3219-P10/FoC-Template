NODE_ENV=development
PORT=3002

# Local PostgreSQL defaults used by compose.yaml.
POSTGRES_DB=foc_supplier
POSTGRES_USER=foc_supplier
POSTGRES_PASSWORD=foc_supplier_dev
POSTGRES_PORT=5434
DATABASE_URL=postgresql://foc_supplier:foc_supplier_dev@localhost:5434/foc_supplier?schema=public

# Must have the same deployment-provided value as user-service.
# Replace with a randomly generated secret of at least 32 characters.
JWT_ACCESS_TOKEN_SECRET=replace-with-an-independent-long-random-secret
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-api
