# Friend on Campus - example environment configuration
# Copy this file to `.env` when implementation begins. Never commit secrets.
# Every variable introduced by a service should have a safe placeholder here.

# Global
LOG_LEVEL=info

# Authentication (reserved for the user service)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# Credit service
CREDIT_SERVICE_PORT=3003
CREDIT_DATABASE_PORT=5435
CREDIT_DATABASE_NAME=foc_credit
CREDIT_DATABASE_USER=foc_credit
CREDIT_DATABASE_PASSWORD=local_credit_password
CREDIT_DATABASE_URL=postgresql://foc_credit:local_credit_password@credit-db:5432/foc_credit
CREDIT_INITIAL_BALANCE=100
CREDIT_TRANSACTION_RETRIES=5
CREDIT_USER_SERVICE_TOKEN=replace-with-at-least-32-random-characters
CREDIT_ORDER_SERVICE_TOKEN=replace-with-a-different-32-character-secret
CREDIT_MONITORING_TOKEN=replace-with-another-32-character-secret
CREDIT_EVENTS_ENABLED=true
CREDIT_EVENTS_QUEUE=credit-service.events
CREDIT_EVENTS_EXCHANGE=foc.events
CREDIT_EVENTS_DEAD_LETTER_EXCHANGE=foc.events.dlx
CREDIT_EVENTS_DEAD_LETTER_QUEUE=credit-service.events.dlq
CREDIT_EVENTS_DEAD_LETTER_ROUTING_KEY=credit-service.events.dead
CREDIT_EVENTS_PREFETCH=10
CREDIT_OUTBOX_POLL_INTERVAL_MS=1000
USER_EVENTS_ENABLED=true
USER_EVENTS_EXCHANGE=foc.events
USER_OUTBOX_POLL_INTERVAL_MS=1000
RABBITMQ_URL=amqp://foc:foc_local_password@rabbitmq:5672
JWT_ACCESS_TOKEN_SECRET=replace-with-the-user-service-jwt-signing-secret
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-api
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STARTUP_TIMEOUT_SECONDS=55
DATABASE_RETRY_INTERVAL_SECONDS=2
