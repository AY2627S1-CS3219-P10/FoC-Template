# Friend on Campus - example environment configuration
# Copy this file to `.env` when implementation begins. Never commit secrets.
# Every variable introduced by a service should have a safe placeholder here.

# Global
LOG_LEVEL=

# Authentication (reserved for the user service)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# Service addresses and persistence variables will be defined after the team
# selects its runtime and infrastructure stack.
