# Friend on Campus - example environment configuration
# Copy this file to `.env` when implementation begins. Never commit secrets.
# Every variable introduced by a service should have a safe placeholder here.

# Global
LOG_LEVEL=info

# Authentication (reserved for the user service)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# Credit service
CREDIT_SERVICE_PORT=3003
CREDIT_DATABASE_NAME=foc_credit
CREDIT_DATABASE_USER=foc_credit
CREDIT_DATABASE_PASSWORD=local_credit_password
CREDIT_DATABASE_URL=postgresql://foc_credit:local_credit_password@credit-db:5432/foc_credit
CREDIT_INITIAL_BALANCE=100
CREDIT_TRANSACTION_RETRIES=5
CREDIT_INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STARTUP_TIMEOUT_SECONDS=55
DATABASE_RETRY_INTERVAL_SECONDS=2
