generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum LedgerEntryType {
  INITIALIZE
  RESERVE
  ADJUST_RESERVE
  ADJUST_RELEASE
  SETTLE
  RELEASE
}

model CreditAccount {
  userId           String              @id @map("user_id") @db.Uuid
  availableCredits Int                 @default(0) @map("available_credits")
  reservedCredits  Int                 @default(0) @map("reserved_credits")
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  requested        CreditReservation[] @relation("RequesterReservations")
  courierPayments  CreditReservation[] @relation("CourierSettlements")
  ledgerEntries    LedgerEntry[]

  @@map("credit_accounts")
}

model CreditReservation {
  reservationId String                        @id @default(uuid()) @map("reservation_id") @db.Uuid
  errandId      String                        @unique @map("errand_id") @db.Uuid
  requesterId   String                        @map("requester_id") @db.Uuid
  courierId     String?                       @map("courier_id") @db.Uuid
  amount        Int
  status        ReservationStatus             @default(RESERVED)
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  settledAt     DateTime?                     @map("settled_at") @db.Timestamptz(3)
  releasedAt    DateTime?                     @map("released_at") @db.Timestamptz(3)
  requester     CreditAccount                 @relation("RequesterReservations", fields: [requesterId], references: [userId], onDelete: Restrict)
  courier       CreditAccount?                @relation("CourierSettlements", fields: [courierId], references: [userId], onDelete: Restrict)
  ledger        LedgerEntry[]
  adjustments   CreditReservationAdjustment[]

  @@index([requesterId])
  @@index([courierId])
  @@index([status, updatedAt])
  @@map("credit_reservations")
}

model CreditReservationAdjustment {
  adjustmentId   String            @id @default(uuid()) @map("adjustment_id") @db.Uuid
  reservationId  String            @map("reservation_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key")
  previousAmount Int               @map("previous_amount")
  targetAmount   Int               @map("target_amount")
  correlationId  String            @map("correlation_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  reservation    CreditReservation @relation(fields: [reservationId], references: [reservationId], onDelete: Restrict)

  @@unique([reservationId, idempotencyKey])
  @@index([reservationId, createdAt])
  @@map("credit_reservation_adjustments")
}

model LedgerEntry {
  ledgerEntryId         String             @id @default(uuid()) @map("ledger_entry_id") @db.Uuid
  accountUserId         String             @map("account_user_id") @db.Uuid
  reservationId         String?            @map("reservation_id") @db.Uuid
  errandId              String?            @map("errand_id") @db.Uuid
  type                  LedgerEntryType
  amount                Int
  availableBalanceAfter Int                @map("available_balance_after")
  reservedBalanceAfter  Int                @map("reserved_balance_after")
  referenceKey          String             @unique @map("reference_key")
  correlationId         String             @map("correlation_id")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  account               CreditAccount      @relation(fields: [accountUserId], references: [userId], onDelete: Restrict)
  reservation           CreditReservation? @relation(fields: [reservationId], references: [reservationId], onDelete: Restrict)

  @@index([accountUserId, createdAt])
  @@index([reservationId])
  @@index([createdAt])
  @@index([errandId])
  @@map("ledger_entries")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash") @db.Char(64)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([eventType, processedAt])
  @@map("processed_events")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id") @db.Uuid
  eventType     String   @map("event_type")
  payload       Json
  published     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([published, createdAt])
  @@map("outbox_events")
}
