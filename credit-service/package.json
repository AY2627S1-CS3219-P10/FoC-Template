{
  "name": "@foc/credit-service",
  "version": "0.1.0",
  "private": true,
  "description": "Transactional credit, escrow, and settlement service for Friend on Campus",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "migrations",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest-unit.json --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest-unit.json --coverage --runInBand && NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest-integration.json --coverage --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config tests/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/microservices": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "0.10.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "fastify": "5.12.5",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.0",
    "@types/amqplib": "0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
