PORT=3004
DATABASE_URL=postgresql://foc_order:local_order_password@127.0.0.1:5436/foc_order
REDIS_URL=redis://127.0.0.1:6380
USER_SERVICE_URL=http://127.0.0.1:3001
SUPPLIER_SERVICE_URL=http://127.0.0.1:3002
CREDIT_SERVICE_URL=http://127.0.0.1:3003
CREDIT_ORDER_SERVICE_TOKEN=replace-with-the-credit-order-service-token
LOG_LEVEL=info
# Outbox relay to RabbitMQ (docs/events.md §5). Must be on for couriers to be paid;
# set to false only to run without RabbitMQ (rows are still written and kept).
ORDER_EVENTS_ENABLED=true
RABBITMQ_URL=amqp://foc:foc_local_password@127.0.0.1:5672
ORDER_EVENTS_EXCHANGE=foc.events
