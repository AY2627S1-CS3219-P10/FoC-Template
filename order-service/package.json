{
  "name": "@foc/order-service",
  "version": "0.1.0",
  "private": true,
  "description": "FR4 errand creation, editing and durable credit coordination",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "migrations",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config tests/jest-unit.json --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config tests/jest-integration.json --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config tests/jest-coverage.json --runInBand --coverage",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "amqplib": "0.10.9",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/amqplib": "0.10.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
