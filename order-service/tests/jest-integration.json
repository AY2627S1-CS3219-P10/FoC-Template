{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "tests/integration/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.spec.json"
      }
    ]
  },
  "testTimeout": 120000,
  "maxWorkers": 1,
  "setupFiles": ["\u003crootDir\u003e/tests/integration/setup-env.ts"]
}
