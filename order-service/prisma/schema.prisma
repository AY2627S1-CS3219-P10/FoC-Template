generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ErrandStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  PICKED_UP
  DELIVERED
  DISPUTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CompletionMethod {
  REQUESTER_CONFIRMED
  AUTO_TIMEOUT
}

enum ActorRole {
  REQUESTER
  COURIER
  ADMIN
  SYSTEM
}

enum OperationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OperationKind {
  CREATE
  EDIT
  DELETE
}

model Errand {
  id                  String            @id @db.Uuid
  requesterId         String            @map("requester_id") @db.Uuid
  courierId           String?           @map("courier_id") @db.Uuid
  status              ErrandStatus      @default(OPEN)
  pickupLocationId    String            @map("pickup_location_id") @db.Uuid
  pickupSupplierName  String            @map("pickup_supplier_name") @db.VarChar(150)
  pickupLocationLabel String            @map("pickup_location_label") @db.VarChar(300)
  description         String            @db.VarChar(1000)
  deliveryDestination String            @map("delivery_destination") @db.VarChar(250)
  instructions        String            @db.VarChar(1000)
  offeredCredits      Int               @map("offered_credits")
  version             Int               @default(0)
  pendingOperationId  String?           @unique @map("pending_operation_id") @db.Uuid
  pendingOperation    ErrandOperation?  @relation("PendingOperation", fields: [pendingOperationId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  acceptedAt          DateTime?         @map("accepted_at") @db.Timestamptz(3)
  pickedUpAt          DateTime?         @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt         DateTime?         @map("delivered_at") @db.Timestamptz(3)
  disputedAt          DateTime?         @map("disputed_at") @db.Timestamptz(3)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  completionMethod    CompletionMethod? @map("completion_method")
  history             ErrandHistory[]

  @@index([status, courierId, createdAt, id])
  @@index([requesterId, createdAt])
  @@map("errands")
}

model ErrandOperation {
  lockedErrand    Errand?         @relation("PendingOperation")
  id              String          @id @default(uuid()) @db.Uuid
  idempotencyKey  String          @map("idempotency_key") @db.Uuid
  requesterId     String          @map("requester_id") @db.Uuid
  errandId        String          @map("errand_id") @db.Uuid
  kind            OperationKind
  status          OperationStatus @default(PENDING)
  inputDigest     String          @map("input_digest") @db.VarChar(64)
  payload         Json
  expectedVersion Int?            @map("expected_version")
  previousAmount  Int?            @map("previous_amount")
  errorCode       String?         @map("error_code") @db.VarChar(100)
  errorStatus     Int?            @map("error_status")
  correlationId   String?         @map("correlation_id") @db.VarChar(128)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([requesterId, idempotencyKey])
  @@index([status, createdAt])
  @@map("errand_operations")
}

model ErrandHistory {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  errandId      String        @map("errand_id") @db.Uuid
  errand        Errand        @relation(fields: [errandId], references: [id], onDelete: Restrict)
  fromStatus    ErrandStatus? @map("from_status")
  toStatus      ErrandStatus  @map("to_status")
  action        String        @db.VarChar(40)
  actorRole     ActorRole     @map("actor_role")
  actorId       String?       @map("actor_id") @db.Uuid
  correlationId String?       @map("correlation_id") @db.VarChar(128)
  occurredAt    DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([errandId, occurredAt])
  @@map("errand_history")
}

model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  payload     Json
  headers     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("outbox_events")
}
