# Server-only service origins (do not append /api).
USER_SERVICE_URL=http://127.0.0.1:3001
ORDER_SERVICE_URL=http://127.0.0.1:3004
SUPPLIER_SERVICE_URL=http://127.0.0.1:3002
CREDIT_SERVICE_URL=http://127.0.0.1:3003
# Server-only provisioning credential; match the Credit Service. Never prefix NEXT_PUBLIC_.
CREDIT_INTERNAL_API_TOKEN=replace-with-the-credit-service-internal-token

# Set this to the exact public HTTPS origin in production. It controls origin
# checks and Secure cookies. Leave unset locally to use the incoming origin.
# APP_ORIGIN=https://campus.example.com
