# Public target. AWS exposes only the web app through CloudFront.
WEB_BASE_URL=https://d1jp4ocurldf39.cloudfront.net

# Direct service targets are local-only; AWS keeps these services private.
USER_BASE_URL=http://localhost:3001
SUPPLIER_BASE_URL=http://localhost:3002
CREDIT_BASE_URL=http://localhost:3003
ORDER_BASE_URL=http://localhost:3004

# Never commit real tokens.
CREDIT_ORDER_SERVICE_TOKEN=

# Mutation fixtures: UUID v4 values from a dedicated test dataset.
ERRAND_ID=
REQUESTER_ID=
AMOUNT=1

# Safety switches must be passed explicitly at run time.
ENVIRONMENT=staging
ALLOW_STRESS=false
ALLOW_MUTATIONS=false
MAX_VUS=500
COMPETITORS=10
ATTEMPTS=20
