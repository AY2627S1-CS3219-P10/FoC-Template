generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED

  @@map("user_status")
}

enum UserReportStatus {
  OPEN
  RESOLVED

  @@map("user_report_status")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  username          String     @unique @db.Citext
  email             String     @unique @db.Citext
  phoneNumber       String     @unique @map("phone_number") @db.VarChar(20)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  isAdmin           Boolean    @default(false) @map("is_admin")
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  suspendedUntil    DateTime?  @map("suspended_until") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  emailVerificationCodes EmailVerificationCode[]
  sessions               Session[]
  reportsSubmitted       UserReport[]            @relation("ReportReporter")
  reportsReceived        UserReport[]            @relation("ReportTarget")
  reportsResolved        UserReport[]            @relation("ReportResolver")

  @@map("users")
}

model UserReport {
  id                String           @id @default(uuid()) @db.Uuid
  reporterUserId    String           @map("reporter_user_id") @db.Uuid
  reportedUserId    String           @map("reported_user_id") @db.Uuid
  description       String           @db.VarChar(500)
  status            UserReportStatus @default(OPEN)
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedByAdminId String?          @map("resolved_by_admin_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter        User  @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reportedUser    User  @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Restrict)
  resolvedByAdmin User? @relation("ReportResolver", fields: [resolvedByAdminId], references: [id], onDelete: Restrict)

  @@index([reportedUserId, status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([status, createdAt])
  @@map("user_reports")
}

model EmailVerificationCode {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}
