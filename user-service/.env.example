NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Local PostgreSQL defaults used by compose.yaml.
POSTGRES_DB=foc_user
POSTGRES_USER=foc_user
POSTGRES_PASSWORD=foc_user_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://foc_user:foc_user_dev@localhost:5433/foc_user?schema=public

# Required only by `pnpm db:seed:admins`. Supply a JSON array containing
# exactly five objects with operator, username, email, phoneNumber, and password.
# Keep real initial passwords in deployment secrets, never in source control.
ADMIN_SEED_ACCOUNTS=

# Replace this with a randomly generated secret of at least 32 characters.
EMAIL_VERIFICATION_CODE_SECRET=replace-with-a-long-random-secret-value

# Used to sign short-lived HS256 access tokens. Verifier services receive the
# same value through deployment secret management; never commit or log it.
JWT_ACCESS_TOKEN_SECRET=replace-with-an-independent-long-random-secret

# BullMQ uses Redis for durable verification-email jobs.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Gmail SMTP uses explicit STARTTLS on port 587: keep SMTP_SECURE=false.
# Store the Gmail address and app password only in an untracked .env or secret
# manager. SMTP_FROM should be the authenticated Gmail address or a configured
# Gmail "Send mail as" alias.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-gmail-address
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM=replace-with-gmail-address
