{
  "name": "@foc/user-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Identity and access service for Friend on Campus",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "nest build",
    "check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\" && eslint \"{src,tests}/**/*.ts\" && tsc --noEmit && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "jest": "30.5.1",
    "prettier": "3.9.8",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
